{
  "note": "Time-edge conformance vectors (criterion 422), one table driving the Python half (python/tests/test_time_edge_vectors.py) and the TypeScript half (typescript/tests/verifier-time-edge-cases.test.ts). Every probe freezes the wall clock at 'clock', so no case depends on the date the suite runs. The skew bound is future-only: +300s passes, +301s fails, the past is unbounded (retention-bounded). Wire stamps carry explicit UTC offsets; both verifiers normalise to UTC before judging them.",
  "frozen_clock": "2026-08-04T12:00:00Z",
  "instants": [
    {
      "name": "north-fall-back-second-occurrence",
      "stamp": "2026-11-01T01:30:00-05:00",
      "utc": "2026-11-01T06:30:00+00:00",
      "phenomenon": "America/New_York fall-back day; the 01:30 wall time occurs twice and the -05:00 offset names the second occurrence (EST), one hour after the first",
      "probes": [
        {
          "clock": "2026-11-01T06:24:59+00:00",
          "result": "FAIL",
          "note": "issued_at 301s ahead of wall clock (> 300s)",
          "exact": true
        },
        {
          "clock": "2026-11-01T06:25:00+00:00",
          "result": "PASS",
          "note": "skew 300s within bound",
          "exact": true
        },
        {
          "clock": "2026-11-01T06:30:00+00:00",
          "result": "PASS",
          "note": "skew 0s within bound",
          "exact": true
        }
      ]
    },
    {
      "name": "north-fall-back-first-occurrence",
      "stamp": "2026-11-01T01:30:00-04:00",
      "utc": "2026-11-01T05:30:00+00:00",
      "phenomenon": "Same ambiguous 01:30 wall time as north-fall-back-second-occurrence, but the -04:00 offset names the first occurrence (EDT); one wall clock, two instants",
      "probes": [
        {
          "clock": "2026-11-01T05:24:59+00:00",
          "result": "FAIL",
          "note": "issued_at 301s ahead of wall clock (> 300s)",
          "exact": true
        },
        {
          "clock": "2026-11-01T05:25:00+00:00",
          "result": "PASS",
          "note": "skew 300s within bound",
          "exact": true
        },
        {
          "clock": "2026-11-01T05:30:00+00:00",
          "result": "PASS",
          "note": "skew 0s within bound",
          "exact": true
        }
      ]
    },
    {
      "name": "south-spring-forward-nonexistent-wall",
      "stamp": "2026-10-04T02:30:00+10:00",
      "utc": "2026-10-03T16:30:00+00:00",
      "phenomenon": "Australia/Sydney spring-forward day; the 02:30 wall time never exists there, but the explicit +10:00 offset still names a real UTC instant",
      "probes": [
        {
          "clock": "2026-10-03T16:24:59+00:00",
          "result": "FAIL",
          "note": "issued_at 301s ahead of wall clock (> 300s)",
          "exact": true
        },
        {
          "clock": "2026-10-03T16:25:00+00:00",
          "result": "PASS",
          "note": "skew 300s within bound",
          "exact": true
        },
        {
          "clock": "2026-10-03T16:30:00+00:00",
          "result": "PASS",
          "note": "skew 0s within bound",
          "exact": true
        }
      ]
    },
    {
      "name": "extreme-positive-offset-crosses-date",
      "stamp": "2026-05-19T00:10:00+14:00",
      "utc": "2026-05-18T10:10:00+00:00",
      "phenomenon": "UTC+14 (Line Islands) just after local midnight: the local calendar date is already a day ahead of the UTC date",
      "probes": [
        {
          "clock": "2026-05-18T10:04:59+00:00",
          "result": "FAIL",
          "note": "issued_at 301s ahead of wall clock (> 300s)",
          "exact": true
        },
        {
          "clock": "2026-05-18T10:05:00+00:00",
          "result": "PASS",
          "note": "skew 300s within bound",
          "exact": true
        },
        {
          "clock": "2026-05-18T10:10:00+00:00",
          "result": "PASS",
          "note": "skew 0s within bound",
          "exact": true
        }
      ]
    },
    {
      "name": "negative-offset-crosses-date-forward",
      "stamp": "2026-05-19T23:50:00-11:00",
      "utc": "2026-05-20T10:50:00+00:00",
      "phenomenon": "Explicit negative offset near local midnight: the UTC instant lands on the next calendar date",
      "probes": [
        {
          "clock": "2026-05-20T10:44:59+00:00",
          "result": "FAIL",
          "note": "issued_at 301s ahead of wall clock (> 300s)",
          "exact": true
        },
        {
          "clock": "2026-05-20T10:45:00+00:00",
          "result": "PASS",
          "note": "skew 300s within bound",
          "exact": true
        },
        {
          "clock": "2026-05-20T10:50:00+00:00",
          "result": "PASS",
          "note": "skew 0s within bound",
          "exact": true
        }
      ]
    }
  ],
